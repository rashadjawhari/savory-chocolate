{
  "hosting": [
    {
      "target": "cakes",
      "public": "dist/cakes",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "**/*.@(html|js|css|json|webmanifest)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ],
      "rewrites": [
        {
          "source": "/track/**",
          "destination": "/track.html"
        }
      ]
    },
    {
      "target": "menu",
      "public": "dist/menu",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "**/*.@(html|js|css|json|webmanifest)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ],
      "rewrites": [
        {
          "source": "/track/**",
          "destination": "/track.html"
        }
      ]
    },
    {
      "target": "admin",
      "public": "dist/admin",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "**/*.@(html|js|css|json|webmanifest)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
